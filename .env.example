# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Secret header required by /api/v1/debug/* routes (non-production only).
# Change this in any shared/staging environment.
DEBUG_SECRET=dev-debug-secret

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlasmassage
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─── Backups ───────────────────────────────────────────────────────────────────
# Directory where pg_dump backups are written. Defaults to /var/backups/atlasmassage.
# Set this in production .env to override.
BACKUP_DIR=/var/backups/atlasmassage

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Leave EMAIL_HOST empty in development. The email service will log all outgoing
# emails (including password reset links) to the console instead of sending them.
#
# For production, set these to your SMTP provider's credentials.
# Recommended providers: Postmark, Resend, SendGrid.
# Example for Postmark:
#   EMAIL_HOST=smtp.postmarkapp.com
#   EMAIL_PORT=587
#   EMAIL_USER=<your-postmark-api-token>
#   EMAIL_PASSWORD=<your-postmark-api-token>  (same as user for Postmark)
#   EMAIL_FROM=noreply@yourdomain.com  (must be a verified sender address)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@atlasmassage.com

# ─── Google Address Validation ──────────────────────────────────────────────────
# Used to verify guest mailing addresses during checkout. Leave empty in development
# to skip verification and accept addresses as entered.
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15551234567

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Application URLs ──────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
